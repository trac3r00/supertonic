{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://supertonic.local/contracts/v1/result.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "sample_rate", "items", "model", "provider", "quality"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "sample_rate": {"type": "integer", "minimum": 1},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["pcm_float32", "valid_sample_count", "duration_seconds"], "properties": {"pcm_float32": {"type": "array", "items": {"type": "number"}}, "valid_sample_count": {"type": "integer", "minimum": 0}, "duration_seconds": {"type": "number", "minimum": 0}}}},
    "model": {"type": "object", "required": ["name", "revision"]},
    "provider": {"type": "object", "required": ["configured", "actual", "dtype"]},
    "quality": {"type": "object", "required": ["steps", "speed", "silence_seconds"]}
  }
}
